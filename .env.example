# App
APP_ENV=development
APP_NAME=AI HR Recruitment Voice Agent
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173
# Local mock call records only. This never enables a live provider integration.
MOCK_CALLS_ENABLED=false

# PostgreSQL (local Docker defaults; change before deployment)
POSTGRES_DB=hr_voice_poc
POSTGRES_USER=hr_voice_user
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://hr_voice_user:change_me_local_only@localhost:5432/hr_voice_poc

# Voice provider credentials — configure only after provider selection is approved
VOICE_PROVIDER=
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_CALLS_ENABLED=false
BOLNA_TIMEOUT_SECONDS=10
BOLNA_FINALIZING_TIMEOUT_SECONDS=900
BOLNA_WEBHOOK_SECRET=
VAPI_API_KEY=
RETELL_API_KEY=
RETELL_CALLS_ENABLED=false
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=
RETELL_TIMEOUT_SECONDS=10

# Offline deterministic response interpreter; no model API or credential is configured.
INTELLIGENCE_PROVIDER=mock
INTELLIGENCE_MODEL=mock-fixture-v1
INTELLIGENCE_API_TIMEOUT_SECONDS=10
INTELLIGENCE_MAX_RESPONSE_CHARS=4000
INTELLIGENCE_MAX_CONTEXT_TURNS=8
INTELLIGENCE_MAX_CONTEXT_CHARS=16000

# Optional LLM/extraction provider — provider choice TBD
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
