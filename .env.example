# App
APP_ENV=development
APP_NAME=AI HR Recruitment Voice Agent
BACKEND_PORT=8000
FRONTEND_PORT=5173

# PostgreSQL (local Docker defaults; change before deployment)
POSTGRES_DB=hr_voice_poc
POSTGRES_USER=hr_voice_user
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://hr_voice_user:change_me_local_only@localhost:5432/hr_voice_poc

# Voice provider credentials — configure only after provider selection is approved
VOICE_PROVIDER=
BOLNA_API_KEY=
VAPI_API_KEY=
RETELL_API_KEY=

# Optional LLM/extraction provider — provider choice TBD
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
